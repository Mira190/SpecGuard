{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "requirements_source",
    "coverage",
    "findings",
    "not_reviewed",
    "standards",
    "layering",
    "requirements"
  ],
  "properties": {
    "requirements_source": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "obligation",
          "source",
          "behaviour",
          "evidence",
          "status",
          "reason",
          "change"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "obligation": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "behaviour": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "line",
                  "quote"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "side": {
                    "enum": [
                      "LEFT",
                      "RIGHT"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "line",
                "quote",
                "layer",
                "proves",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "layer": {
                  "enum": [
                    "unit",
                    "component",
                    "integration",
                    "e2e"
                  ]
                },
                "proves": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "assertion",
                    "no_assertion",
                    "disabled",
                    "removed"
                  ]
                },
                "side": {
                  "enum": [
                    "LEFT",
                    "RIGHT"
                  ]
                }
              }
            }
          },
          "status": {
            "enum": [
              "covered",
              "weak_test",
              "missing_test",
              "higher_level_only",
              "needs_human",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "line",
                  "quote"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "side": {
                    "enum": [
                      "LEFT",
                      "RIGHT"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "line",
          "quote",
          "title",
          "body",
          "confidence",
          "obligation_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "missing_test",
              "weak_test",
              "standard",
              "pushdown"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "rule_source": {
            "type": "string"
          },
          "rule_quote": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "low"
            ]
          },
          "quote": {
            "type": "string"
          },
          "obligation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "side": {
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          }
        }
      }
    },
    "not_reviewed": {
      "type": "string"
    },
    "standards": {
      "type": "object",
      "required": [
        "status",
        "sources",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "no_rules",
            "not_reviewed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layering": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "not_reviewed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "quote",
          "obligation_ids",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "obligation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
