{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "docs_reviewed",
    "requirements_found",
    "requirements",
    "not_reviewed"
  ],
  "properties": {
    "docs_reviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements_found": {
      "type": "integer",
      "minimum": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "text",
          "class",
          "status",
          "code",
          "tests",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "line",
              "quote"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 12,
                "maxLength": 200
              }
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "static",
              "unit",
              "higher_level",
              "human"
            ]
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "missing_test",
              "not_implemented",
              "contradicted",
              "unknown",
              "needs_human"
            ]
          },
          "code": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "line",
                "quote"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 200
                }
              }
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "line",
                "quote",
                "layer"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 200
                },
                "layer": {
                  "enum": [
                    "unit",
                    "component",
                    "integration",
                    "e2e"
                  ]
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "not_reviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
